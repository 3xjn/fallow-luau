diff --git a/tests/untrack.spec.luau b/tests/untrack.spec.luau
index 7e11b5c..0b46a98 100644
--- a/tests/untrack.spec.luau
+++ b/tests/untrack.spec.luau
@@ -26,6 +26,22 @@ local function shouldPauseTracking()
 	assert(c() == 0, getFunctionName())
 end
 
+local function shouldKeepNestedPauseActiveUntilBothResumes()
+	local src, setSrc = signal(0)
+	local runs = 0
+	signals.effect(function()
+		runs += 1
+		pauseTracking()
+		pauseTracking()
+		resumeTracking()
+		src()
+		resumeTracking()
+	end)
+	setSrc(1)
+	assert(runs == 1, getFunctionName())
+end
+
 shouldPauseTracking()
+shouldKeepNestedPauseActiveUntilBothResumes()
 
 return {}
