diff --git a/tests/effect.spec.luau b/tests/effect.spec.luau
index 9d55560..e4abc55 100644
--- a/tests/effect.spec.luau
+++ b/tests/effect.spec.luau
@@ -282,6 +282,26 @@ local function shouldHandleFlagsAreIndirectlyUpdatedDuringCheckDirty()
 	assert(triggers == 2, getFunctionName())
 end
 
+local function shouldPreserveEffectCallbackErrors()
+	local success, err = pcall(function()
+		effect(function()
+			error("initial effect failure")
+		end)
+	end)
+	assert(not success and string.find(tostring(err), "initial effect failure", 1, true), getFunctionName())
+
+	local value, setValue = signal(0)
+	effect(function()
+		if value() == 1 then
+			error("rerun effect failure")
+		end
+	end)
+	success, err = pcall(function()
+		setValue(1)
+	end)
+	assert(not success and string.find(tostring(err), "rerun effect failure", 1, true), getFunctionName())
+end
+
 shouldClearSubscriptionsWhenUntrackedByAllSubscribers()
 shouldNotRunUntrackedInnerEffect()
 shouldRunOuterEffectFirst()
@@ -292,5 +312,6 @@ shouldCustomEffectSupportBatch()
 shouldDuplicateSubscribersDoNotAffectTheNotifyOrder()
 shouldHandleSideEffectWithInnerEffects()
 shouldHandleFlagsAreIndirectlyUpdatedDuringCheckDirty()
+shouldPreserveEffectCallbackErrors()
 
 return {}
