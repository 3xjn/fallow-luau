diff --git a/tests/FlagCache.spec.luau b/tests/FlagCache.spec.luau
index 59e01ca..8adb2a5 100644
--- a/tests/FlagCache.spec.luau
+++ b/tests/FlagCache.spec.luau
@@ -71,4 +71,24 @@ h.test("FlagCache: non-empty quotaLimited clears all flags", function()
     h.expectEqual(store.requestId, "req-3", "request metadata still updated")
 end)
 
+h.test("FlagCache: successful refresh removes absent flags, payloads, and details", function()
+    local store = FlagCache.empty()
+    FlagCache.applyResponse(store, {
+        flags = {
+            old = {
+                enabled = true,
+                metadata = { id = 1, payload = { version = 1 } },
+            },
+        },
+        requestId = "first",
+    })
+    FlagCache.applyResponse(store, { featureFlags = { current = false }, requestId = "second" })
+
+    h.expectNil(FlagCache.getValue(store, "old"))
+    h.expectNil(FlagCache.getPayload(store, "old"))
+    h.expectNil(FlagCache.getDetails(store, "old"))
+    h.expectFalse(FlagCache.getValue(store, "current"))
+    h.expectEqual(store.requestId, "second")
+end)
+
 return true
