+	local success, err = pcall(function()
+		effect(function()
+			getValue()
+			runs += 1
+			error("initial effect failed")
+		end)
+	end)
+	assert(not success, getFunctionName())
+	assert(string.find(tostring(err), "initial effect failed", 1, true), getFunctionName())
+
+	setValue(1)
+	assert(runs == 1, getFunctionName())
+end
