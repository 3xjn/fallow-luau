+tests.reconcileRefusesAConcurrentFutureProfile = function()
+	local payload = {
+		version = ProfilePersistence.Version,
+		coins = 10,
+		fulfilledPurchaseIds = {},
+		redeemedCodes = {},
+	}
+	local stored = {
+		version = ProfilePersistence.Version + 1,
+		coins = 20,
+		futureField = "keep",
+		fulfilledPurchaseIds = { futureReceipt = true },
+		redeemedCodes = {},
+	}
+
+	local ok = pcall(ProfilePersistence.reconcileWithStored, payload, stored)
+	assertCondition(not ok, "UpdateAsync must abort rather than overwrite a future profile")
+	assertCondition(
+		stored.version == ProfilePersistence.Version + 1,
+		"Future version stays untouched"
+	)
+	assertCondition(stored.futureField == "keep", "Future-only data stays untouched")
+	assertCondition(
+		stored.fulfilledPurchaseIds.futureReceipt == true,
+		"Stored receipt stays untouched"
+	)
+	assertCondition(payload.coins == 10, "Rejected reconciliation leaves the payload untouched")
 end
 
