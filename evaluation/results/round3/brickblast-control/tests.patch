+tests.boardGridRejectsNonIntegerAndNonFiniteCoordinates = function()
+	local children = boardGridChildren()
+	children[3].boardX = 1.5
+	assertCondition(
+		not UIControlRules.validateBoardGridChildren(children),
+		"A fractional X coordinate cannot identify a board cell"
+	)
+
+	children = boardGridChildren()
+	children[3].boardY = 2.5
+	assertCondition(
+		not UIControlRules.validateBoardGridChildren(children),
+		"A fractional Y coordinate cannot identify a board cell"
+	)
+
+	children = boardGridChildren()
+	children[3].boardX = 0 / 0
+	assertCondition(
+		not UIControlRules.validateBoardGridChildren(children),
+		"NaN cannot identify a board cell"
+	)
+end
